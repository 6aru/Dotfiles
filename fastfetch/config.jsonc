{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/bmo.txt",
    "padding": {
      "top": 0,
      "right": 2,
    },
  },
  "display": {
    "separator": " : ",
  },
  "modules": [
    {
      "type": "title",
      "key": " USR",
      "keyColor": "red",
    },
    {
      "type": "os",
      "key": " OS  ",
      "keyColor": "green",
    },
    {
      "type": "uptime",
      "key": " UP ",
      "keyColor": "yellow",
    },
    {
      "type": "cpu",
      "key": "󰍛  CPU",
      "keyColor": "blue",
    },
    {
      "type": "gpu",
      "key": " GPU",
      "keyColor": "magenta",
    },
    {
      "type": "memory",
      "key": "󰟖 RAM",
      "keyColor": "cyan",
    },
    {
      "type": "disk",
      "key": " MEM",
      "keyColor": "white",
      "folders": "/",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[31m󰈸  \u001b[32m󱥰  \u001b[33m󰩃  \u001b[34m  \u001b[35m  \u001b[36m󰆥  \u001b[37m󰤄  \u001b[38m",
    },
  ],
}
